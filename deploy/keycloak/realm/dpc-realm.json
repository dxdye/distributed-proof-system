{
  "realm": "dpc",
  "displayName": "Distributed Proof Check (development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "dpc-maintainer",
        "description": "Maintainer of Distributed Proof Check: escalations, release of reports. Every grant and revocation is logged by the service."
      }
    ]
  },
  "clients": [
    {
      "clientId": "dpc-web",
      "name": "Distributed Proof Check web client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience dpc-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dpc-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dpc-test",
      "name": "Automated tests only (password grant). Never configure this in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience dpc-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dpc-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "maintainer",
      "enabled": true,
      "email": "maintainer@example.invalid",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Maintainer",
      "credentials": [{ "type": "password", "value": "maintainer", "temporary": false }],
      "realmRoles": ["dpc-maintainer"]
    },
    {
      "username": "reviewer1",
      "enabled": true,
      "email": "reviewer1@example.invalid",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Reviewer One",
      "credentials": [{ "type": "password", "value": "reviewer1", "temporary": false }]
    },
    {
      "username": "reviewer2",
      "enabled": true,
      "email": "reviewer2@example.invalid",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Reviewer Two",
      "credentials": [{ "type": "password", "value": "reviewer2", "temporary": false }]
    }
  ]
}
